BoundingBoxDrawer{
   background-color:rgba(20,20,20,200);
}
QPushButton {
    background-color: rgba(90,180,170,255);
    color: white;
    font-weight: bold;
    font-size:16px;
    border-radius: 10px;
    padding: 5px;
    width:100px;
}
QPushButton:hover{
    background-color: rgba(90,180,170,150);
}
QPushButton:pressed {
    background-color: #f39c12;
    padding-top: 12px;
}
QComboBox{
    font-size:16px;
    color: #f5f5f5;
    background-color:rgba(90,180,170,150);
    padding:5px;
    border-radius:10px;
    width:80px;                                   
}
QComboBox::drop-down {
    width: 30px;
}
QComboBox QAbstractItemView {
    background-color: #1e272e;       
    color: white;                  
    selection-background-color: #f39c12; 
    selection-color: black;        
}